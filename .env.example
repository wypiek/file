# Local defaults work without changes: http://localhost:8080
PUBLIC_URL=http://localhost:8080
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443

# Production example (DNS must point to your server):
# PUBLIC_URL=https://files.example.com
# SITE_ADDRESS=files.example.com
# HTTP_PORT=80
# HTTPS_PORT=443

MAX_FILE_BYTES=104857600
STORAGE_QUOTA_BYTES=10737418240
# Optional: require this secret for uploads (downloads remain public).
UPLOAD_KEY=
