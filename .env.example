# Copy this file to .env next to compose.yaml. Compose reads it automatically.
# Public HTTP port on the VPS; the container listens on 6968 internally.
HTTP_PORT=6968

# Local default: http://localhost:6968
PUBLIC_URL=http://localhost:6968

# VPS: set the exact public HTTP address, including HTTP_PORT.
# PUBLIC_URL=http://YOUR_VPS_IP:6968
# Or: PUBLIC_URL=http://files.example.com:6968

MAX_FILE_BYTES=104857600
STORAGE_QUOTA_BYTES=10737418240
# Optional: require this secret for uploads (downloads remain public).
UPLOAD_KEY=
